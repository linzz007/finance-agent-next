{
  "versions": [
    "2.0.0",
    "1.0.0"
  ],
  "description": "Analyze assigned articles and reconstruct the author's reasoning, conditions and uncertainties.",
  "instructions": "analyst",
  "input_requirements": [
    "A task message, task-specific success_criteria, and explicitly authorized focal source handles.",
    "output_contract defaults to the Analyst result contract; optional profile_options.review_mode and review_options control independent review."
  ],
  "output_contract": "finance.analyst_result.v2",
  "allowed_tools": [
    "article.list",
    "article.search",
    "article.read",
    "article.claims",
    "tool.describe",
    "material.get",
    "web.search",
    "web.open",
    "market.catalog",
    "market.snapshot",
    "market.metrics",
    "market.series",
    "personal.catalog",
    "context.open",
    "company_wiki_search",
    "agent.spawn",
    "agent.wait",
    "agent.status",
    "agent.send",
    "agent.cancel",
    "agent.resume",
    "result.get"
  ],
  "allowed_child_profiles": [
    "general",
    "analyst",
    "verifier",
    "skeptic"
  ],
  "input_contracts": [
    "finance.research_task@1",
    "finance.review_request@1"
  ],
  "output_contracts": [
    "finance.analyst_result@2",
    "finance.research_result@1",
    "finance.child@1"
  ],
  "context_policy": {
    "history": "task_local",
    "materials": "explicit_refs",
    "parent_context": "explicit_only"
  }
}
