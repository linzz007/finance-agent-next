# Copy this file to .env.local and fill in your own API key.
# .env.local is ignored by git and is loaded automatically by run_finance.py.

ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash
# Optional named profile: gpt, gpt-responses or deepseek; CLI overrides this.
AGENT_WORKBENCH_MODEL_PROFILE=
# Used only by the deepseek profile; never falls back to the GPT credential.
DEEPSEEK_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# openai-compatible uses /chat/completions; openai-responses uses /responses.
AGENT_WORKBENCH_MODEL_PROTOCOL=anthropic

# Optional runtime settings
POLICY_IMPACT_API_PORT=8510
# Relative paths are resolved against this project; external roots are rejected.
# Layout: <root>/<author>/articles/*.md
FINANCE_ARTICLE_ROOT=data/finance/articles
AGENT_WORKBENCH_MODEL_MAX_TOKENS=2048
AGENT_WORKBENCH_MODEL_TEMPERATURE=0
AGENT_WORKBENCH_MODEL_TIMEOUT=45
AGENT_WORKBENCH_MODEL_ATTEMPTS=5
# Optional model-side SSE for either OpenAI text protocol (not the browser trace stream).
AGENT_WORKBENCH_MODEL_STREAM=false
AGENT_WORKBENCH_MODEL_STREAM_MAX_SECONDS=600

# Finance research caps; provisional capacity estimates, not provider guarantees.
FINANCE_RESEARCH_RUN_SECONDS=3600
FINANCE_RESEARCH_FINAL_SECONDS=600
FINANCE_RESEARCH_CHILD_SECONDS=1200
FINANCE_RESEARCH_CHILD_FINAL_SECONDS=120
FINANCE_RESEARCH_ROOT_REQUESTS=600
FINANCE_RESEARCH_ROOT_FINAL_REQUESTS=24
FINANCE_RESEARCH_DECISION_REQUESTS=5
FINANCE_RESEARCH_MAX_DELEGATES=40
# Configured ceiling, not a provider capacity certification. Smaller limits win.
FINANCE_RESEARCH_INPUT_TOKENS=1000000
# 0 means provider capacity unknown; the 1M project ceiling still applies.
FINANCE_RESEARCH_CONTEXT_TOKENS=1000000
FINANCE_RESEARCH_OUTPUT_TOKENS=32768
FINANCE_RESEARCH_SAFETY_TOKENS=4096
FINANCE_RESEARCH_CONTEXT_PRESSURE_PERCENT=70
FINANCE_RESEARCH_CONTEXT_TARGET_PERCENT=60
